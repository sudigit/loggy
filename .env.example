# ULPF Environment Configuration Example
# Copy this file to .env and customize values as needed

# =============================================================================
# Listener Configuration
# =============================================================================

# Syslog Listener (UDP)
# Enable/disable syslog listener
ULPF_SYSLOG_ENABLED=true
# Syslog UDP port (1-65535)
ULPF_SYSLOG_PORT=5514
# Syslog channel identifier
ULPF_SYSLOG_CHANNEL=udp:5514

# HTTP API Listener
# Enable/disable HTTP API
ULPF_HTTP_ENABLED=true
# HTTP API port (1-65535)
ULPF_HTTP_PORT=8080

# File Watcher
# Enable/disable file watcher
ULPF_FILEWATCHER_ENABLED=true
# Path to log file to watch
ULPF_FILEWATCHER_PATH=data/incoming/squid_access.log
# File watcher channel identifier
ULPF_FILEWATCHER_CHANNEL=file:squid
# Poll interval in seconds
ULPF_FILEWATCHER_POLL_INTERVAL=0.5

# =============================================================================
# DLQ Processing Configuration
# =============================================================================

# Time threshold: Process DLQ after this many seconds (whichever comes first)
ULPF_DLQ_TIME_THRESHOLD=60
# Count threshold: Process DLQ after this many pending events (whichever comes first)
ULPF_DLQ_COUNT_THRESHOLD=20

# =============================================================================
# Self-Heal Configuration
# =============================================================================

# Enable/disable self-heal component
ULPF_SELFHEAL_ENABLED=true

# =============================================================================
# Base Paths (usually no need to change)
# =============================================================================

# Base directory for ULPF data
# ULPF_BASE_DIR=
# Data directory for logs and database
# ULPF_DATA_DIR=

# =============================================================================
# Local LLM (Ollama) Configuration
# =============================================================================

# Ollama URL for AI-powered proposal generation
ULPF_OLLAMA_URL=http://localhost:11434
# Ollama model to use
ULPF_OLLAMA_MODEL=qwen2.5-coder

# =============================================================================
# Storage Configuration
# =============================================================================

# Buffer type: auto, redis, or direct
ULPF_BUFFER_TYPE=auto
# Redis URL (if using redis buffer)
ULPF_REDIS_URL=redis://localhost:6379/0

# Raw storage type: auto, minio, or local
ULPF_RAW_STORE=auto
# MinIO endpoint (if using minio storage)
ULPF_MINIO_ENDPOINT=localhost:9000
# MinIO credentials (if using minio storage)
ULPF_MINIO_ACCESS_KEY=minioadmin
ULPF_MINIO_SECRET_KEY=minioadmin
# =============================================================================
# Output Sinks (where normalized events go)
# =============================================================================

# Comma-separated: jsonl, elastic, minio, syslog_cef, kafka
# "minio" uploads normalized events to MinIO in batches (uses the MinIO settings above)
ULPF_SINKS=jsonl,minio
# Bucket for normalized events (raw events use ULPF_MINIO_BUCKET)
ULPF_MINIO_NORMALIZED_BUCKET=ulpf-normalized-events
# Upload a batch every N events or every N seconds, whichever comes first
ULPF_MINIO_SINK_BATCH_SIZE=500
ULPF_MINIO_SINK_FLUSH_SECONDS=5
